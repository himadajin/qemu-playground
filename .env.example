# Copy to .env and fill in real values. .env is gitignored; never commit it.
# See docs/user/self-hosting.md for how to obtain each value.

# Cloudflare Tunnel token for the cloudflared service in compose.yaml.
# Cloudflare Zero Trust dashboard: Networks > Tunnels > (tunnel) > Configure > token.
TUNNEL_TOKEN=

# Cloudflare API token ("Edit Cloudflare Workers" template) and account ID,
# used by `wrangler deploy` and the GitHub Actions deploy secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare Access service token for the API hostname, stored as Worker
# secrets via `wrangler secret put`.
# Cloudflare Zero Trust dashboard: Access > Service Auth.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
